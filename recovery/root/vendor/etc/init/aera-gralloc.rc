# Android 13 libui uses the matching allocator HAL for native GPU scanout.
service aera-gralloc /vendor/bin/hw/vendor.qti.hardware.display.allocator-service
    class hal
    user root
    group root graphics drmrpc
    seclabel u:r:recovery:s0
    interface android.hardware.graphics.allocator@3.0::IAllocator default
    interface android.hardware.graphics.allocator@4.0::IAllocator default
    setenv LD_LIBRARY_PATH /vendor/lib64:/vendor/lib64/egl:/system/lib64
