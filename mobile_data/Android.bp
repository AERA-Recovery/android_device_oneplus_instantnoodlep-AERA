package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

cc_binary {
    name: "aera-cellular-provider",
    recovery: true,
    srcs: ["daemon.cpp"],
    include_dirs: ["bootable/recovery"],
    cpp_std: "c++17",
    rtti: false,
    cppflags: ["-fexceptions"],
    cflags: ["-Wall", "-Wextra", "-Werror"],
    static_libs: ["libjsoncpp"],
    shared_libs: ["libcutils", "libcrypto"],
    required: ["aera-mobile-modem", "aera-mobile-tftp"],
}

cc_binary {
    name: "aera-mobile-modem",
    recovery: true,
    srcs: ["modem-guard.cpp"],
    cpp_std: "c++17",
    rtti: false,
    cppflags: ["-fexceptions"],
    cflags: ["-Wall", "-Wextra", "-Werror"],
    shared_libs: ["libcutils"],
}

cc_binary {
    name: "aera-mobile-tftp",
    recovery: true,
    stl: "none",
    srcs: [":aera_tqftpserv_sources", "translate-safe.c", "tftp-endpoint.c"],
    static_libs: ["libaera_qrtr"],
    header_libs: ["aera_tqftpserv_headers"],
    cflags: ["-D_GNU_SOURCE", "-Wno-unused-parameter"],
    ldflags: ["-Wl,--wrap=qrtr_publish"],
}
